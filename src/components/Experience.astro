---
import SectionHeader from './SectionHeader.astro';

const experiences = [
  {
    company: "ORANGE",
    role: "SENIOR SOFTWARE ENGINEER",
    project: "Provisioning",
    period: "JAN 2024 - PRESENT",
    current: true,
    description: "Building the platform that orchestrates fiber provisioning with Telefónica's wholesale services (NEBA and NEBA Local), replacing a legacy system",
    achievements: [
      "Built from scratch with my team and taken to production, where it handles new customer activations every day",
      "Simplified a highly complex integration with Telefónica into a flow that runs reliably",
      "Obsessive about quality: continuous optimization and bug hunting so that every activation goes through cleanly",
      "Event-driven design with Kafka and long-running workflows orchestrated with Uber Cadence",
      "Technical reference within the team, regularly brought into design and technical decisions"
    ],
    tags: ["Java 21", "Vert.x", "Kafka", "Uber Cadence", "Kubernetes", "GCP", "Bazel", "OpenAPI"]
  },
  {
    company: "BBVA NEXT TECHNOLOGIES",
    role: "SOFTWARE ARCHITECT",
    project: "LRBA · Batch Architecture",
    period: "MAR 2020 - JAN 2024",
    current: false,
    description: "Lead developer and architect of the bank's batch processing architecture, designed from scratch with my team",
    achievements: [
      "Conceived and designed a Spark-on-Kubernetes batch architecture and took it from zero to production",
      "Adopted by many applications across the bank, running hundreds of processes every night",
      "Made batch development accessible to teams with no Spark experience",
      "Connectors for Oracle, DB2, MongoDB, ElasticSearch, S3 and HDFS"
    ],
    tags: ["Apache Spark", "Kubernetes", "Java", "Python", "ETL", "CI/CD"]
  },
  {
    company: "BBVA NEXT TECHNOLOGIES",
    role: "SOFTWARE ARCHITECT",
    project: "APX · Core Banking Architecture",
    period: "JUN 2018 - MAR 2020",
    current: false,
    description: "Developer in the architecture team behind the platform that processes 80% of the bank's transactions",
    achievements: [
      "Migrated the architecture's MongoDB library, a critical component nobody was keen to touch",
      "Diagnosed and fixed a thread management bottleneck in the architecture, significantly reducing processing times",
      "Contributed to the early design of the move to gRPC microservices",
      "Services running on Docker, OpenShift and Kubernetes"
    ],
    tags: ["Java", "OSGI", "gRPC", "MongoDB", "Oracle", "OpenShift"]
  },
  {
    company: "ODILO",
    role: "FULL STACK DEVELOPER",
    project: "Digital Archive & Preservation",
    period: "MAR 2014 - JUN 2018",
    current: false,
    description: "Document archiving and digital preservation software for public administration",
    achievements: [
      "Designed a digital preservation tool compliant with Spanish government regulations, working directly from the official legal texts",
      "Adapted the archive to e-government processes and electronic records under the ENI (National Interoperability Framework)",
      "Modernized a late-90s product: from Java 6, EJB, Struts, JSP and Ant to Spring services, Java 8, AngularJS and Gradle",
      "Implemented full agile workflow with daily standups and code reviews"
    ],
    tags: ["Java", "Spring", "AngularJS", "Gradle", "AWS", "Legacy Migration", "Agile"]
  }
];
---

<section id="experience" class="section experience-section">
  <div class="container">
    <SectionHeader title="EXPERIENCE" subtitle="12+ YEARS • ENTERPRISE-SCALE SOLUTIONS" />

    <div class="experiences">
      {experiences.map((exp, index) => (
        <div class="exp-card">
          <div class="exp-number">{String(index + 1).padStart(2, '0')}</div>

          {exp.current && (
            <div class="current-badge">NOW</div>
          )}

          <div class="exp-header">
            <h3 class="exp-role">{exp.role}</h3>
            <div class="exp-meta">
              <div class="exp-company">{exp.company}</div>
              <div class="exp-period">{exp.period}</div>
            </div>
            <div class="exp-project">{exp.project}</div>
          </div>

          <div class="exp-divider"></div>

          <p class="exp-description">{exp.description}</p>

          <div class="exp-achievements">
            {exp.achievements.map((achievement) => (
              <div class="achievement-item">
                <div class="achievement-marker"></div>
                <span>{achievement}</span>
              </div>
            ))}
          </div>

          <div class="exp-tags">
            {exp.tags.map((tag) => (
              <span class="exp-tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    background: var(--color-bg);
  }

  .experiences {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
    max-width: 1000px;
    margin: 0 auto;
  }

  .exp-card {
    border: var(--border-width) solid var(--color-border);
    padding: var(--spacing-2xl);
    background: var(--color-bg);
    position: relative;
    transition: var(--transition);
  }

  .exp-card:hover {
    transform: translate(6px, 6px);
    box-shadow: -6px -6px 0 var(--color-border);
  }

  .exp-number {
    position: absolute;
    top: -20px;
    left: var(--spacing-lg);
    background: var(--color-bg-tertiary);
    color: var(--color-accent);
    font-family: var(--font-sans);
    font-size: 2rem;
    font-weight: 700;
    padding: 0.5rem 1.5rem;
    border: var(--border-width) solid var(--color-border);
  }

  .current-badge {
    position: absolute;
    top: -20px;
    right: var(--spacing-lg);
    background: var(--color-accent);
    color: var(--color-bg-tertiary);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.5rem 1.5rem;
    letter-spacing: 0.15em;
    border: var(--border-width) solid var(--color-border);
  }

  .exp-header {
    margin-bottom: var(--spacing-lg);
  }

  .exp-role {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-sm);
  }

  .exp-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-xs);
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .exp-company {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    letter-spacing: 0.05em;
  }

  .exp-period {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .exp-project {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .exp-divider {
    width: 100%;
    height: var(--border-width);
    background: var(--color-border);
    margin: var(--spacing-lg) 0;
  }

  .exp-description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-lg);
  }

  .exp-achievements {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-lg);
  }

  .achievement-item {
    display: flex;
    gap: var(--spacing-sm);
    align-items: start;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  .achievement-marker {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
  }

  .exp-tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border: 2px solid var(--color-border);
    background: var(--color-bg);
    letter-spacing: 0.02em;
    transition: var(--transition);
  }

  .exp-tag:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .exp-card {
      padding: var(--spacing-lg);
      padding-top: var(--spacing-xl);
    }

    .exp-number {
      font-size: 1.25rem;
      padding: 0.375rem 0.875rem;
      top: -12px;
      left: var(--spacing-md);
    }

    .current-badge {
      font-size: 0.75rem;
      padding: 0.375rem 0.875rem;
      top: -12px;
      right: var(--spacing-md);
    }

    .exp-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .exp-role {
      font-size: 1.25rem;
    }

    .exp-company {
      font-size: 1rem;
    }
  }
</style>
